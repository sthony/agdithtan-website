# ─── PostgreSQL connection ───────────────────────────────────────────────────
# Option A — single connection string (takes priority if set)
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/agdith

# Option B — individual vars (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agdith
DB_USERNAME=user
DB_PASSWORD=password

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret

# ─── Email ────────────────────────────────────────────────────────────────────
SMTP_USER=agdithtan@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_EMAIL=agdithtan@gmail.com
